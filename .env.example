# Copy to .env and fill in — NEVER commit .env to version control.
#
# IBKR Gateway / TWS must be running locally before bootstrap.
# Paper trading Gateway default port: 4002
# Paper trading TWS default port: 7497

# Optional overrides (defaults come from configs/dev.yaml)
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002
# IBKR_CLIENT_ID=10

# Artifact root override (optional)
# VOL_INFRA_ARTIFACTS_DIR=artifacts
# VOL_INFRA_LOGS_DIR=logs
